+   (test "end of a string" '(0 3) #t)
+   (test "beyond a string" '(0 4) #f)
+   (test "inside a nested string" '(1 0 1) #t)
+   (test "after a compound tree" '(1 1) #t)
+   (test "invalid compound position" '(1 2) #f)
+   (test "missing paragraph" '(2 0) #f)
